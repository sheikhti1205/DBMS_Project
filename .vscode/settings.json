{
  "python.defaultInterpreterPath": "${env:HOME}/.cache/byteforge-dbms/venv/bin/python",
  "terminal.integrated.profiles.linux": {
    "ByteForge Bash": {
      "path": "/usr/bin/bash",
      "args": [
        "-l"
      ]
    }
  },
  "terminal.integrated.defaultProfile.linux": "ByteForge Bash",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.fileDirectoryAsCwd": true,
  "code-runner.preserveFocus": false,
  "code-runner.showExecutionMessage": false,
  "code-runner.executorMap": {
    "sh": "bash"
  },
  "code-runner.executorMapByFileExtension": {
    ".sh": "bash"
  },
  "latex-workshop.latex.recipe.default": "Generate measurements and build PDF",
  "latex-workshop.latex.recipes": [
    {
      "name": "Generate measurements and build PDF",
      "tools": [
        "generate-report-measurements",
        "latexmk-report"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "generate-report-measurements",
      "command": "python3",
      "args": [
        "%DIR%/measure.py"
      ],
      "cwd": "%DIR%"
    },
    {
      "name": "latexmk-report",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "-auxdir=%AUXDIR%",
        "%DOC%"
      ],
      "cwd": "%DIR%"
    }
  ],
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.autoClean.run": "onSucceeded",
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.clean.subfolder.enabled": false,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.bcf",
    "*.blg",
    "*.fdb_latexmk",
    "*.fls",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.log",
    "*.lol",
    "*.lot",
    "*.nav",
    "*.out",
    "*.run.xml",
    "*.snm",
    "*.synctex(busy)",
    "*.synctex.gz",
    "*.synctex.gz(busy)",
    "*.toc",
    "*.vrb",
    "*.xdv",
    "*-blx.bib"
  ],
  "sqltools.connections": [
    {
      "name": "ByteForge SQLite",
      "driver": "SQLite",
      "database": "${workspaceFolder:DBMS_Project}/schema/environment.db",
      "previewLimit": 200
    }
  ],
  "sqltools.results.limit": 200
}

    "Monthly_Climate_Summary": ["Station_Name", "Year", "Month", "Maximum_Temperature", "Minimum_Temperature", "Humidity", "Rainfall", "Thunderstorm", "Lightning"],
    "Monthly_Wind_Summary": ["Station_Name", "Year", "Month", "Maximum_Wind_Speed", "Maximum_Wind_Direction", "Minimum_Wind_Speed", "Minimum_Wind_Direction"]
  },
  "required_checks": {
    "Year_Time": ["BETWEEN 1900 AND 2100"],
    "Month_Time": ["BETWEEN 1 AND 12"],
    "Day_Time": ["BETWEEN 1 AND 12", "BETWEEN 1 AND 31", "STRFTIME"],
    "Fiscal_Year": ["END_YEAR", "START_YEAR + 1"],
    "Temperature_Record": ["IN ('MAXIMUM', 'MINIMUM')", "BETWEEN -5 AND 50"],
    "Humidity_Record": ["BETWEEN 0 AND 100"],
    "Rainfall_Record": ["BETWEEN 0 AND 3000"],
    "Wind_Record": ["IN ('MAXIMUM', 'MINIMUM')", "BETWEEN 0 AND 250"],
    "Climatic_Event_Record": ["THUNDERSTORM", ">= 0", "LIGHTNING"],
    "Sunshine_Record": ["BETWEEN 0 AND 14"],
    "Radiation_Record": ["SAMPLE_NO", ">= 0"],
    "Water_Quality": ["PARAMETER_TYPE", "BETWEEN 0 AND 14", "ELSE", ">= 0"],
    "Forest_Area_Record": ["PROTECTED_AREA", "TOTAL_FOREST_LAND", ">= 0"],
    "Type_Of_Establishments": ["QUANTITY", ">= 0", "PERCENTAGE", "BETWEEN 0 AND 100"],
    "Industry_Usage": ["QUANTITY", ">= 0", "PERCENTAGE", "BETWEEN 0 AND 100"]
  }

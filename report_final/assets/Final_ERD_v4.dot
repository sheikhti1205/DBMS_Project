digraph ERD {
  graph [rankdir=TB, splines=polyline, overlap=false, concentrate=false,
         bgcolor=white, pad=0.18, nodesep=0.30, ranksep=0.48,
         ratio=compress,
         fontname="Times New Roman", fontsize=14,
         label="Primary key (PK) and foreign key (FK) annotations",
         labelloc=t, labeljust=l];
  node [shape=plain, fontname="Times New Roman", fontsize=14];
  edge [color="#1f4e79", penwidth=1.15, arrowsize=0.75];
  "Year_Time" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9ead3" ALIGN="CENTER"><B>Year Time</B></TD></TR><TR><TD ALIGN="LEFT">Year [PK]</TD></TR></TABLE>>];
  "Month_Time" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9ead3" ALIGN="CENTER"><B>Month Time</B></TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK]</TD></TR></TABLE>>];
  "Day_Time" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9ead3" ALIGN="CENTER"><B>Day Time</B></TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Day [PK]</TD></TR></TABLE>>];
  "Fiscal_Year" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9ead3" ALIGN="CENTER"><B>Fiscal Year</B></TD></TR><TR><TD ALIGN="LEFT">Start_Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">End_Year [PK, FK]</TD></TR></TABLE>>];
  "Station" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#e7e6e6" ALIGN="CENTER"><B>Station</B></TD></TR><TR><TD ALIGN="LEFT">Station_Name [PK]</TD></TR></TABLE>>];
  "District" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#e7e6e6" ALIGN="CENTER"><B>District</B></TD></TR><TR><TD ALIGN="LEFT">District_Name [PK]</TD></TR></TABLE>>];
  "River" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#e7e6e6" ALIGN="CENTER"><B>River</B></TD></TR><TR><TD ALIGN="LEFT">River_Name [PK]</TD></TR></TABLE>>];
  "River_Station" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#e7e6e6" ALIGN="CENTER"><B>River Station</B></TD></TR><TR><TD ALIGN="LEFT">WQ_Station_Name [PK]</TD></TR><TR><TD ALIGN="LEFT">River_Name [FK]</TD></TR></TABLE>>];
  "Size" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#e7e6e6" ALIGN="CENTER"><B>Size</B></TD></TR><TR><TD ALIGN="LEFT">Size_Name [PK]</TD></TR></TABLE>>];
  "Industrial_Type" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#e7e6e6" ALIGN="CENTER"><B>Industrial Type</B></TD></TR><TR><TD ALIGN="LEFT">Industry_Name [PK]</TD></TR></TABLE>>];
  "Temperature_Record" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9e7f5" ALIGN="CENTER"><B>Temperature Record</B></TD></TR><TR><TD ALIGN="LEFT">Station_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Type [PK]</TD></TR><TR><TD ALIGN="LEFT">Temp</TD></TR></TABLE>>];
  "Humidity_Record" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9e7f5" ALIGN="CENTER"><B>Humidity Record</B></TD></TR><TR><TD ALIGN="LEFT">Station_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Humidity</TD></TR></TABLE>>];
  "Rainfall_Record" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9e7f5" ALIGN="CENTER"><B>Rainfall Record</B></TD></TR><TR><TD ALIGN="LEFT">Station_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Rainfall</TD></TR></TABLE>>];
  "Wind_Record" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9e7f5" ALIGN="CENTER"><B>Wind Record</B></TD></TR><TR><TD ALIGN="LEFT">Station_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Type [PK]</TD></TR><TR><TD ALIGN="LEFT">Wind_Speed</TD></TR><TR><TD ALIGN="LEFT">Direction</TD></TR></TABLE>>];
  "Climatic_Event_Record" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9e7f5" ALIGN="CENTER"><B>Climatic Event Record</B></TD></TR><TR><TD ALIGN="LEFT">Station_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Thunderstorm</TD></TR><TR><TD ALIGN="LEFT">Lightning</TD></TR></TABLE>>];
  "Sunshine_Record" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9e7f5" ALIGN="CENTER"><B>Sunshine Record</B></TD></TR><TR><TD ALIGN="LEFT">Station_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Day [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Sunshine_Hours</TD></TR></TABLE>>];
  "Radiation_Record" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#d9e7f5" ALIGN="CENTER"><B>Radiation Record</B></TD></TR><TR><TD ALIGN="LEFT">Station_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Month [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Day [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Sample_No [PK]</TD></TR><TR><TD ALIGN="LEFT">Radiation</TD></TR></TABLE>>];
  "Water_Quality" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#fce5cd" ALIGN="CENTER"><B>Water Quality</B></TD></TR><TR><TD ALIGN="LEFT">WQ_Station_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Parameter_Type [PK]</TD></TR><TR><TD ALIGN="LEFT">Value</TD></TR></TABLE>>];
  "Forest_Area_Record" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#fce5cd" ALIGN="CENTER"><B>Forest Area Record</B></TD></TR><TR><TD ALIGN="LEFT">District_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Fiscal_Start_Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Fiscal_End_Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Protected_Area</TD></TR><TR><TD ALIGN="LEFT">Unclassed_State_Forest_FD_Acre</TD></TR><TR><TD ALIGN="LEFT">Unclassed_State_Forest_Admin_Acre</TD></TR><TR><TD ALIGN="LEFT">Reserved_Forest_Section_20_Acre</TD></TR><TR><TD ALIGN="LEFT">Reserved_Forest_Section_4_6_Acre</TD></TR><TR><TD ALIGN="LEFT">Acquired_Vested_Forest</TD></TR><TR><TD ALIGN="LEFT">Total_Forest_FD_Acre</TD></TR><TR><TD ALIGN="LEFT">Total_Forest_Land</TD></TR></TABLE>>];
  "Type_Of_Establishments" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#fce5cd" ALIGN="CENTER"><B>Type Of Establishments</B></TD></TR><TR><TD ALIGN="LEFT">Size_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Start_Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">End_Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Quantity</TD></TR><TR><TD ALIGN="LEFT">Percentage</TD></TR></TABLE>>];
  "Industry_Usage" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5f6b76"><TR><TD BGCOLOR="#fce5cd" ALIGN="CENTER"><B>Industry Usage</B></TD></TR><TR><TD ALIGN="LEFT">Industry_Name [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Start_Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">End_Year [PK, FK]</TD></TR><TR><TD ALIGN="LEFT">Quantity</TD></TR><TR><TD ALIGN="LEFT">Percentage</TD></TR></TABLE>>];
  { rank=same; "Temperature_Record"; "Humidity_Record"; "Rainfall_Record"; "Wind_Record"; "Climatic_Event_Record"; }
  "Temperature_Record" -> "Humidity_Record" [style=invis, weight=100];
  "Humidity_Record" -> "Rainfall_Record" [style=invis, weight=100];
  "Rainfall_Record" -> "Wind_Record" [style=invis, weight=100];
  "Wind_Record" -> "Climatic_Event_Record" [style=invis, weight=100];
  { rank=same; "Sunshine_Record"; "Radiation_Record"; "Station"; "Month_Time"; "Day_Time"; "Year_Time"; }
  "Sunshine_Record" -> "Radiation_Record" [style=invis, weight=100];
  "Radiation_Record" -> "Station" [style=invis, weight=100];
  "Station" -> "Month_Time" [style=invis, weight=100];
  "Month_Time" -> "Day_Time" [style=invis, weight=100];
  "Day_Time" -> "Year_Time" [style=invis, weight=100];
  "Temperature_Record" -> "Sunshine_Record" [style=invis, weight=100];
  { rank=same; "Water_Quality"; "River_Station"; "River"; "District"; "Fiscal_Year"; }
  "Water_Quality" -> "River_Station" [style=invis, weight=100];
  "River_Station" -> "River" [style=invis, weight=100];
  "River" -> "District" [style=invis, weight=100];
  "District" -> "Fiscal_Year" [style=invis, weight=100];
  "Sunshine_Record" -> "Water_Quality" [style=invis, weight=100];
  { rank=same; "Forest_Area_Record"; "Type_Of_Establishments"; "Size"; "Industry_Usage"; "Industrial_Type"; }
  "Forest_Area_Record" -> "Type_Of_Establishments" [style=invis, weight=100];
  "Type_Of_Establishments" -> "Size" [style=invis, weight=100];
  "Size" -> "Industry_Usage" [style=invis, weight=100];
  "Industry_Usage" -> "Industrial_Type" [style=invis, weight=100];
  "Water_Quality" -> "Forest_Area_Record" [style=invis, weight=100];
  "Climatic_Event_Record" -> "Month_Time" [constraint=false];
  "Climatic_Event_Record" -> "Station" [constraint=false];
  "Day_Time" -> "Month_Time" [constraint=false];
  "Fiscal_Year" -> "Year_Time" [constraint=false];
  "Forest_Area_Record" -> "District" [constraint=false];
  "Forest_Area_Record" -> "Fiscal_Year" [constraint=false];
  "Humidity_Record" -> "Month_Time" [constraint=false];
  "Humidity_Record" -> "Station" [constraint=false];
  "Industry_Usage" -> "Fiscal_Year" [constraint=false];
  "Industry_Usage" -> "Industrial_Type" [constraint=false];
  "Month_Time" -> "Year_Time" [constraint=false];
  "Radiation_Record" -> "Day_Time" [constraint=false];
  "Radiation_Record" -> "Station" [constraint=false];
  "Rainfall_Record" -> "Month_Time" [constraint=false];
  "Rainfall_Record" -> "Station" [constraint=false];
  "River_Station" -> "River" [constraint=false];
  "Sunshine_Record" -> "Day_Time" [constraint=false];
  "Sunshine_Record" -> "Station" [constraint=false];
  "Temperature_Record" -> "Month_Time" [constraint=false];
  "Temperature_Record" -> "Station" [constraint=false];
  "Type_Of_Establishments" -> "Fiscal_Year" [constraint=false];
  "Type_Of_Establishments" -> "Size" [constraint=false];
  "Water_Quality" -> "River_Station" [constraint=false];
  "Water_Quality" -> "Year_Time" [constraint=false];
  "Wind_Record" -> "Month_Time" [constraint=false];
  "Wind_Record" -> "Station" [constraint=false];
}
